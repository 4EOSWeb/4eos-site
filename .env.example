# Copy to .env beside package.json. Restart `next start` after changing it.
# Do not commit .env.

# Ticket mail. The form emails the help desk (support) or sales (assessment).
# Port 587 uses STARTTLS. Set SMTP_SECURE=true for implicit TLS on port 465.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Support mailbox. Defaults to helpdesk@4eos.com. Assessments go to sales@4eos.com.
INTAKE_TO=

# Used only when SMTP_HOST is empty.
RESEND_API_KEY=
INTAKE_FROM=

# Private analytics page at /analytics. Both are required or the page stays closed.
ANALYTICS_USER=
ANALYTICS_PASSWORD=
# How long visitor facts are kept. Default 400 days.
ANALYTICS_RETENTION_DAYS=400
# Leave empty. Company names are not looked up until this is set.
COMPANY_ENRICHMENT_KEY=
# IPinfo token. Used to learn city, state, and network. The address is not stored.
IPINFO_TOKEN=
