# Copy to .env beside package.json. Restart `next start` after changing it.
# Do not commit .env.

# Core - Webhook trigger URL from the Rewst workflow.
REWST_WEBHOOK_URL=https://engine.rewst.io/webhooks/custom/trigger/{TriggerID}/{OrganizationID}

# Optional. Forms still open the Rewst ticket when this is unset.
RESEND_API_KEY=
INTAKE_TO=
INTAKE_FROM=

# Private analytics page at /analytics. Both are required or the page stays closed.
ANALYTICS_USER=
ANALYTICS_PASSWORD=
# How long visitor facts are kept. Default 400 days.
ANALYTICS_RETENTION_DAYS=400
# Leave empty. Company names are not looked up until this is set.
COMPANY_ENRICHMENT_KEY=
# IPinfo token. Used to learn city, state, and network. The address is not stored.
IPINFO_TOKEN=
